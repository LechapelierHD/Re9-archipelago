<Window x:Class="RE9.AP.Launcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RE Requiem Archipelago" Background="{DynamicResource AppBackgroundBrush}"
        Width="1400" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" Icon="/assets/logo_small.png">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="268" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="18,22,18,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,26">
          <Image Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" Source="/assets/logo_small.png" />
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="16" FontWeight="Bold" Text="RE Requiem" Foreground="{DynamicResource AccentBrush}" />
            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}" Text="ARCHIPELAGO" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <TextBlock Margin="4,0,0,10" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}" Text="MENU" />
          <Button x:Name="NavHome" Style="{StaticResource NavButtonStyle}" Click="NavHome_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavIconStyle}" Text="&#xE80F;" />
              <TextBlock VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="Accueil" />
            </StackPanel>
          </Button>
          <Button x:Name="NavJoin" Style="{StaticResource NavButtonStyle}" Click="NavJoin_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavIconStyle}" Text="&#xE768;" />
              <TextBlock VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="Rejoindre un multimonde" />
            </StackPanel>
          </Button>
          <Button x:Name="NavHost" Style="{StaticResource NavButtonStyle}" Click="NavHost_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavIconStyle}" Text="&#xE716;" />
              <TextBlock VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="Héberger un multimonde" />
            </StackPanel>
          </Button>
          <Button x:Name="NavSetup" Style="{StaticResource NavButtonStyle}" Click="NavSetup_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavIconStyle}" Text="&#xE713;" />
              <TextBlock VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="État de la configuration" />
            </StackPanel>
          </Button>
          <Button x:Name="NavUpdates" Style="{StaticResource NavButtonStyle}" Click="NavUpdates_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavIconStyle}" Text="&#xE777;" />
              <TextBlock VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="Mises à jour" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Grid.Row="3" Margin="0,0,0,14" Padding="14,12" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}" Text="SESSION EN COURS" />
            <TextBlock x:Name="SessionText" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="SessionDetailText" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="PayloadText" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Row="4">
          <Button Style="{StaticResource SidebarSmallButtonStyle}" Click="Language_Click" ToolTip="Changer la langue du lanceur (Français / English).">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavIconStyle}" FontSize="13" Width="24" Text="&#xE774;" />
              <TextBlock VerticalAlignment="Center" Text="Langue : Français" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SidebarSmallButtonStyle}" Click="CheckUpdates_Click" ToolTip="Cherche une nouvelle mise à jour du client.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavIconStyle}" FontSize="13" Width="24" Text="&#xE895;" />
              <TextBlock x:Name="CheckUpdatesText" VerticalAlignment="Center" Text="Rechercher des mises à jour" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SidebarSmallButtonStyle}" Click="BugReport_Click" ToolTip="Crée une archive (journaux, état de session, sans mot de passe) à joindre sur Discord.">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavIconStyle}" FontSize="13" Width="24" Text="&#xEBE8;" />
              <TextBlock VerticalAlignment="Center" Text="Générer un rapport de bug" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SidebarSmallButtonStyle}" Click="OpenLogs_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavIconStyle}" FontSize="13" Width="24" Text="&#xE838;" />
              <TextBlock VerticalAlignment="Center" Text="Ouvrir le dossier des journaux" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SidebarSmallButtonStyle}" Click="Credits_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource NavIconStyle}" FontSize="13" Width="24" Text="&#xE734;" />
              <TextBlock VerticalAlignment="Center" Text="Crédits" />
            </StackPanel>
          </Button>
          <TextBlock Margin="2,8,0,0" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}">
            <Run Text="Propulsé par " /><Hyperlink Click="ArchipelagoLink_Click"><Run Text="Archipelago" /></Hyperlink>
            <Run Text=" et " /><Hyperlink Click="ReFrameworkLink_Click"><Run Text="REFramework" /></Hyperlink>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="22,18,22,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
      <Border x:Name="UpdateBanner" Margin="0,0,0,12" Padding="16,12" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,2,14,0" Text="&#xE896;" />
          <TextBlock x:Name="UpdateTitle" Grid.Column="1" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <Button x:Name="UpdateButton" Style="{StaticResource InlinePrimaryButtonStyle}" Content="Mettre à jour" Click="Update_Click" />
            <Button Style="{StaticResource InlineButtonStyle}" Content="Plus tard" Click="UpdateLater_Click" />
          </StackPanel>
        </Grid>
      </Border>
      <Border x:Name="ErrorBanner" Margin="0,0,0,12" Padding="12,8" Background="{DynamicResource DangerBackgroundBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ErrorText" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" />
          <Button Grid.Column="1" Margin="12,0,0,0" Padding="10,2" VerticalAlignment="Center" Content="Fermer" Click="DismissError_Click" />
        </Grid>
      </Border>
      </StackPanel>
      <Border Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="14">
        <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="34,30">
          <ContentControl x:Name="ScreenHost" />
        </ScrollViewer>
      </Border>
      <StackPanel x:Name="FooterPanel" Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal" />
      <Border Grid.Row="3" Margin="0,12,0,0" Padding="12,8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="10">
        <Expander IsExpanded="False" ExpandDirection="Up">
          <Expander.Header>
            <TextBlock x:Name="StatusText" Margin="4,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Text="Prêt." />
          </Expander.Header>
          <TextBox x:Name="LogBox" Margin="0,8,0,0" Background="#00FFFFFF" BorderThickness="0" FontFamily="Consolas" FontSize="13" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" MinHeight="120" MaxHeight="220" />
        </Expander>
      </Border>
    </Grid>
  </Grid>
</Window>
