<UserControl x:Class="RE9.AP.Launcher.Views.HostView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Héberger un multimonde" />
    <TextBlock Style="{StaticResource BodyTextStyle}" Text="La génération d'un multimonde se fait sur ta propre installation d'Archipelago. Ce guide t'accompagne étape par étape. Ta progression est sauvegardée : tu peux fermer cette fenêtre et revenir quand tu veux." />
    <TextBlock x:Name="StepCounter" FontWeight="SemiBold" Margin="0,0,0,12" />

    <Border Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource StepChipStyle}">
          <TextBlock x:Name="StepNumber" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
        </Border>
        <StackPanel Grid.Column="1">
          <Grid>
            <TextBlock x:Name="StepTitle" Style="{StaticResource StepTitleStyle}" />
            <TextBlock x:Name="StepDone" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" Text="✓ Terminé" Visibility="Collapsed" />
          </Grid>

          <StackPanel x:Name="PanelAp" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource BodyTextStyle}" Text="RE Requiem nécessite Archipelago 0.6.8 (0.6.2 minimum). S'il est déjà installé, le lanceur le trouve ci-dessous ; sinon installe-le d'abord (installateur Windows classique), puis reviens ici." />
            <Grid Margin="0,4,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ApPathBox" Padding="6,5" TextChanged="ApPathBox_TextChanged" />
              <Button Grid.Column="1" Margin="10,0,0,0" Padding="12,5" Content="Parcourir..." Click="BrowseAp_Click" />
            </Grid>
            <TextBlock x:Name="ApStatus" Margin="0,0,0,10" TextWrapping="Wrap" />
            <Button Style="{StaticResource InlineButtonStyle}" HorizontalAlignment="Left" Content="Obtenir Archipelago 0.6.8 (page de version)" Click="GetAp_Click" />
          </StackPanel>

          <StackPanel x:Name="PanelWorld" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource BodyTextStyle}" Text="L'apworld apprend RE Requiem à Archipelago (objets, emplacements, règles). Le lanceur fournit la version qui correspond à son client : installe-la dans custom_worlds. À refaire après chaque mise à jour du lanceur." />
            <TextBlock x:Name="WorldStatus" Margin="0,0,0,10" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Style="{StaticResource InlinePrimaryButtonStyle}" Content="Installer l'apworld RE Requiem" Click="InstallWorld_Click" />
              <Button Style="{StaticResource InlineButtonStyle}" Content="Ouvrir custom_worlds" Click="OpenWorlds_Click" />
            </WrapPanel>
          </StackPanel>

          <StackPanel x:Name="PanelYaml" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource BodyTextStyle}" Text="Ajoute le YAML de chaque joueur (le tien est déjà là si tu l'as créé dans « Rejoindre »). Les autres jeux du multimonde ont besoin de leur propre apworld dans custom_worlds." />
            <ListBox x:Name="YamlList" MinHeight="140" MaxHeight="260" Padding="4" BorderThickness="1" Margin="0,4,0,8" />
            <WrapPanel>
              <Button Style="{StaticResource InlinePrimaryButtonStyle}" Content="Ajouter des YAML..." Click="AddYaml_Click" />
              <Button Style="{StaticResource InlineButtonStyle}" Content="Retirer la sélection" Click="RemoveYaml_Click" />
              <Button Style="{StaticResource InlineButtonStyle}" Content="Mes YAML" Click="OpenYamlDir_Click" />
            </WrapPanel>
            <TextBlock x:Name="YamlStatus" Style="{StaticResource HintTextStyle}" />
          </StackPanel>

          <StackPanel x:Name="PanelGenerate" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource BodyTextStyle}" Text="Archipelago mélange les objets de tous les joueurs et produit un fichier AP_xxxx.zip : c'est ta partie. La génération prend de quelques secondes à quelques minutes ; le détail s'affiche dans le journal en bas." />
            <Button x:Name="GenerateButton" Style="{StaticResource InlinePrimaryButtonStyle}" HorizontalAlignment="Left" Content="Générer le multimonde" Click="Generate_Click" />
            <TextBlock x:Name="GenerateStatus" Margin="0,6,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel x:Name="PanelHost" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource BodyTextStyle}" Text="Deux façons d'ouvrir la room :" />
            <Border Style="{StaticResource CardStyle}" Background="{DynamicResource SurfaceAltBrush}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Sur archipelago.gg (recommandé)" />
                <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,4,0,8" Text="Envoie le .zip sur la page d'upload, puis « Create New Room ». Partage l'adresse affichée (archipelago.gg:xxxxx) aux joueurs. Rien à laisser ouvert sur ton PC." />
                <WrapPanel>
                  <Button Style="{StaticResource InlinePrimaryButtonStyle}" Content="Ouvrir la page d'upload" Click="Upload_Click" />
                  <Button Style="{StaticResource InlineButtonStyle}" Content="Afficher le .zip" Click="RevealZip_Click" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Background="{DynamicResource SurfaceAltBrush}">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="Sur ton PC" />
                <TextBlock Style="{StaticResource BodyTextStyle}" Margin="0,4,0,8" Text="Lance ArchipelagoServer avec la partie. Adresse : localhost:38281 pour toi, ton IP locale ou publique (port 38281 ouvert) pour les autres. La fenêtre du serveur doit rester ouverte pendant toute la partie." />
                <Button Style="{StaticResource InlineButtonStyle}" HorizontalAlignment="Left" Content="Démarrer le serveur local" Click="LocalServer_Click" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="PanelDone" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource BodyTextStyle}" Text="La room est ouverte. Envoie son adresse à tous les joueurs. Pour jouer toi-même, va dans « Rejoindre un multimonde » : tes réglages sont déjà remplis, il ne reste que l'adresse." />
            <Button Style="{StaticResource InlinePrimaryButtonStyle}" HorizontalAlignment="Left" Content="Rejoindre ma partie" Click="JoinMine_Click" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
