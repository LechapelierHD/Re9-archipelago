<UserControl x:Class="RE9.AP.Launcher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border x:Name="PlaytestBanner" Style="{StaticResource BannerStyle}" Background="{DynamicResource DangerBackgroundBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" Visibility="Collapsed">
      <DockPanel>
        <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top" Fill="#FFE53935" />
        <TextBlock x:Name="PlaytestText" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource DangerTextBrush}" />
      </DockPanel>
    </Border>
    <Border x:Name="SessionBanner" Style="{StaticResource BannerStyle}" Background="{DynamicResource SuccessBackgroundBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" Visibility="Collapsed">
      <StackPanel>
        <TextBlock x:Name="BannerTitle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource SuccessTextBrush}" />
        <TextBlock x:Name="BannerBody" Margin="0,4,0,10" TextWrapping="Wrap" FontSize="12" />
        <WrapPanel>
          <Button Style="{StaticResource InlinePrimaryButtonStyle}" Content="Lancer RE Requiem" Click="Launch_Click" />
          <Button Style="{StaticResource InlineButtonStyle}" Content="Vérifier la room" Click="Verify_Click" />
          <Button Style="{StaticResource InlineButtonStyle}" Content="J'ai fini avec ce multimonde" Click="Done_Click" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <Grid HorizontalAlignment="Center" Margin="0,10,0,0">
      <Ellipse Width="330" Height="330" Fill="{DynamicResource PortraitGlowBrush}" />
      <Image Width="270" Height="270" Source="/assets/logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>
    <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Text="RESIDENT EVIL REQUIEM • RANDOMIZER ARCHIPELAGO" />
    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="32" FontWeight="Bold" Text="Bienvenue, survivant." />
    <TextBlock x:Name="Tagline" Margin="0,10,0,0" HorizontalAlignment="Center" MaxWidth="620" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" />
    <Border x:Name="Hint" Margin="0,22,0,0" HorizontalAlignment="Center" Padding="16,10" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0">
      <StackPanel Orientation="Horizontal">
        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Text="&#xE72B;" />
        <TextBlock VerticalAlignment="Center" Text="Choisis Rejoindre un multimonde ou Héberger un multimonde dans le menu de gauche pour commencer." />
      </StackPanel>
    </Border>
    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
      <TextBlock x:Name="ScriptsText" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" />
      <Button x:Name="ScriptsButton" Style="{StaticResource InlineButtonStyle}" Content="Mettre à jour les scripts du jeu" Click="Repatch_Click" ToolTip="Recopie les scripts et données du lanceur dans le jeu (même room, même progression)." />
    </StackPanel>
    <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Text="Les objets reçus arrivent dans le coffre. Connecte-toi en jeu (Insert) avant de ramasser quoi que ce soit." />
    <TextBlock x:Name="AiShareText" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
  </StackPanel>
</UserControl>
