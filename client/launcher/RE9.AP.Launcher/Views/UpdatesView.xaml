<UserControl x:Class="RE9.AP.Launcher.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Style="{StaticResource PageTitleStyle}" Text="Mises à jour" />
    <TextBlock Style="{StaticResource BodyTextStyle}" Text="Les nouveautés ajoutées par la dernière mise à jour du client." />

    <Border Style="{StaticResource CardStyle}">
      <StackPanel>
        <TextBlock x:Name="InstalledText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="GameText" Margin="0,4,0,0" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="SourceText" Margin="0,4,0,0" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="Installer un patch téléchargé à la main" />
          <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap"
                     Text="Dépose le zip du patch (re9ap_patch_X.zip) dans le dossier « Patchs » à côté du lanceur : il est proposé tout de suite, puis rangé dans « installés »." />
          <TextBlock x:Name="ManualText" Margin="0,4,0,0" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Padding="12,5" Content="Ouvrir le dossier des patchs" Click="OpenPatches_Click" />
          <Button x:Name="ClearInstalledBtn" Margin="0,8,0,0" Padding="12,5" Content="Vider les vieux patchs" Click="ClearInstalled_Click" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Style="{StaticResource SectionRuleStyle}">
      <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="DERNIÈRE MISE À JOUR" />
    </Border>
    <TextBlock x:Name="EmptyText" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
    <StackPanel x:Name="PatchList" />
  </StackPanel>
</UserControl>
