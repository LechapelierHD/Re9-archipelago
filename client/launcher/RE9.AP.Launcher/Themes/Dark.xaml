<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dgp="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0D0B0C" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FF161314" />
  <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF1F1A1B" />
  <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FF262021" />
  <SolidColorBrush x:Key="SubtleBorderBrush" Color="#FF3A2E30" />
  <SolidColorBrush x:Key="TextBrush" Color="#FFF3ECEC" />
  <SolidColorBrush x:Key="SubtleTextBrush" Color="#FFAA9A9C" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FFC62828" />
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFE53935" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#33C62828" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#FF110E0F" />
  <RadialGradientBrush x:Key="PortraitGlowBrush">
    <GradientStop Offset="0.0" Color="#80B71C1C" />
    <GradientStop Offset="0.55" Color="#33B71C1C" />
    <GradientStop Offset="1.0" Color="#00B71C1C" />
  </RadialGradientBrush>
  <SolidColorBrush x:Key="SuccessTextBrush" Color="#FF7BD69B" />
  <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="#FF1C2E22" />
  <SolidColorBrush x:Key="SuccessBorderBrush" Color="#FF3E6B4E" />
  <SolidColorBrush x:Key="InfoTextBrush" Color="#FF8FC4F5" />
  <SolidColorBrush x:Key="InfoBackgroundBrush" Color="#FF1B2836" />
  <SolidColorBrush x:Key="InfoBorderBrush" Color="#FF3C5A78" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="#FFE8C26A" />
  <SolidColorBrush x:Key="WarningBackgroundBrush" Color="#FF332A16" />
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#FF6B5A2E" />
  <SolidColorBrush x:Key="DangerTextBrush" Color="#FFF08A8A" />
  <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#FF34201F" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="#FF7A4444" />
  <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="dgp:TextBoxBase.CaretBrush" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="4,3" />
  </Style>
  <ControlTemplate x:Key="ThemedComboBoxToggleTemplate" TargetType="{x:Type dgp:ToggleButton}">
    <Border Name="Bd" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
      <Path Name="Arrow" Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M0,0 L8,0 L4,5" Fill="{DynamicResource SubtleTextBrush}" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter TargetName="Bd" Value="{DynamicResource AccentBrush}" Property="Border.BorderBrush" />
      </Trigger>
      <Trigger Property="UIElement.IsEnabled" Value="False">
        <Setter TargetName="Bd" Value="{DynamicResource SurfaceAltBrush}" Property="Border.Background" />
        <Setter TargetName="Arrow" Value="{DynamicResource SubtleTextBrush}" Property="Shape.Fill" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="SearchBoxStyle" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Margin="8,0,6,0" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" Text="" />
              <Grid Column="1">
                <TextBlock Name="Placeholder" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" IsHitTestVisible="False" Text="{TemplateBinding FrameworkElement.Tag}" Visibility="Collapsed" />
                <ScrollViewer Name="PART_ContentHost" Margin="0,0,8,0" VerticalAlignment="Center" />
              </Grid>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <DataTrigger Value="" Binding="{Binding Text, RelativeSource={RelativeSource Self}}">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <dgp:ToggleButton ClickMode="Press" Focusable="False" Template="{DynamicResource ThemedComboBoxToggleTemplate}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Margin="9,0,26,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" TextElement.Foreground="{DynamicResource TextBrush}" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}" ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource TemplatedParent}}" />
            <dgp:Popup Name="PART_Popup" AllowsTransparency="True" Focusable="False" Placement="Bottom" PopupAnimation="Fade" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}">
              <Border MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer>
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </dgp:Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.6" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ComboBoxItem}" TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Padding" Value="9,5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border Name="Bd" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Control.Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource AccentBrush}" Property="Border.Background" />
              <Setter Value="{DynamicResource AccentForegroundBrush}" Property="Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style x:Key="{x:Type RadioButton}" TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style x:Key="{x:Type ListBox}" TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBox}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
            <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
              <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Bd" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="7">
            <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource AccentBrush}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Value="{DynamicResource SurfaceAltBrush}" Property="Border.Background" />
              <Setter Value="{DynamicResource SubtleTextBrush}" Property="Foreground" />
              <Setter TargetName="Bd" Property="UIElement.Opacity" Value="0.65" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF161314" />
  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFF3ECEC" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF1F1A1B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFF3ECEC" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF1F1A1B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF161314" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF3A2E30" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF161314" />
  <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFF3ECEC" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FF1F1A1B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#FFF3ECEC" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FFC62828" />
  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF1F1A1B" />
  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFF3ECEC" />
  <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF7E7072" />
  <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="#FF1F1A1B" />
  <Color x:Key="{x:Static SystemColors.WindowFrameColorKey}">#FF3A2E30</Color>
  <Color x:Key="{x:Static SystemColors.WindowColorKey}">#FF161314</Color>
  <Color x:Key="{x:Static SystemColors.ControlColorKey}">#FF1F1A1B</Color>
  <Style x:Key="{x:Type Window}" TargetType="{x:Type Window}">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
  </Style>
  <Style x:Key="{x:Type TabControl}" TargetType="{x:Type TabControl}">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
  </Style>
  <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Border Name="Tab" Padding="{TemplateBinding Control.Padding}" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" SnapsToDevicePixels="True">
            <ContentPresenter Name="Header" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource SubtleTextBrush}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Header" Value="{DynamicResource TextBrush}" Property="TextElement.Foreground" />
            </Trigger>
            <Trigger Property="TabItem.IsSelected" Value="True">
              <Setter TargetName="Tab" Value="{DynamicResource AccentBrush}" Property="Border.Background" />
              <Setter TargetName="Tab" Value="{DynamicResource AccentBrush}" Property="Border.BorderBrush" />
              <Setter TargetName="Header" Value="{DynamicResource AccentForegroundBrush}" Property="TextElement.Foreground" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Header" Value="{DynamicResource SubtleTextBrush}" Property="TextElement.Foreground" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type Expander}" TargetType="{x:Type Expander}">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
  </Style>
  <Style x:Key="{x:Type Slider}" TargetType="{x:Type Slider}">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
  </Style>
  <Style x:Key="{x:Type ProgressBar}" TargetType="{x:Type ProgressBar}">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
  </Style>
  <Style x:Key="{x:Type ListBoxItem}" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style x:Key="{x:Type ScrollViewer}" TargetType="{x:Type ScrollViewer}">
    <Setter Property="Background" Value="#00FFFFFF" />
  </Style>
  <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
  </Style>
  <Style x:Key="{x:Type DataGrid}" TargetType="{x:Type DataGrid}">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="DataGrid.RowBackground" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="DataGrid.AlternatingRowBackground" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="DataGrid.VerticalGridLinesBrush" Value="{DynamicResource SubtleBorderBrush}" />
  </Style>
  <Style x:Key="{x:Type dgp:DataGridColumnHeader}" TargetType="{x:Type dgp:DataGridColumnHeader}">
    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style x:Key="{x:Type DataGridRow}" TargetType="{x:Type DataGridRow}">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  </Style>
  <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}" />
  </Style>
  <Style x:Key="{x:Type Hyperlink}" TargetType="{x:Type Hyperlink}">
    <Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}" />
  </Style>
</ResourceDictionary>