<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RE9.AP.Launcher</AssemblyName>
    <RootNamespace>RE9.AP.Launcher</RootNamespace>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>RE Requiem Archipelago</Product>
    <Company>RE Requiem Archipelago</Company>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\logo.png" />
    <Resource Include="assets\logo_small.png" />
  </ItemGroup>
  <!-- Jeton GitHub en lecture seule pour le dépôt privé des mises à jour (fichier hors du code) -->
  <ItemGroup Condition="Exists('..\update_token.txt')">
    <EmbeddedResource Include="..\update_token.txt" LogicalName="update_token.txt" />
  </ItemGroup>
</Project>
